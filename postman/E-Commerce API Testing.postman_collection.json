          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response contains products\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response).to.have.property(\"products\");\n});\n\npm.test(\"Products should be an array\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.products).to.be.an(\"array\");\n});\n\npm.test(\"Response time is below 1000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(1000);\n});"
                ]
              }
            }
          ],
