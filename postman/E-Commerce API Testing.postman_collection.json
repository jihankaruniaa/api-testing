      "name": "Authentication",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response contains access token\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response).to.have.property(\"accessToken\");\n});\n\npm.test(\"Response contains user ID\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response).to.have.property(\"id\");\n});\n\nconst response = pm.response.json();\n\npm.environment.set(\"token\", response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"emilys\",\n    \"password\": \"emilyspass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
